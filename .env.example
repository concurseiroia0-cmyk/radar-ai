# ============================================================================
# RADAR AI — Variáveis de ambiente
# Copie para .env.local e preencha. Nunca commite .env.local.
# ============================================================================

# ---- Supabase (Auth + PostgreSQL + RLS + Realtime) ----
# Sem estas variáveis o app roda em MODO DEMONSTRAÇÃO (dados sintéticos).
# Setup: rode supabase/migrations/0001_init.sql no SQL Editor → no Dashboard
# adicione o schema "radar_ai" em Project Settings → API → Exposed schemas →
# copie URL + anon key + service key.
# ⚠️ TODO o schema do app vive no schema PostgreSQL isolado "radar_ai"
# (nunca em public) — não interfere em outros apps do mesmo projeto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service (SOMENTE server-side — nunca exponha no cliente).
# Obrigatória: sem ela as páginas voltam a exibir dados de demonstração e
# cron candles/sinais + backtest não gravam no banco.
SUPABASE_SERVICE_KEY=

# ---- Market Data (gratuitas) ----
# Twelve Data: https://twelvedata.com (800 créditos/dia no free)
TWELVEDATA_KEY=
# Finnhub (fallback): https://finnhub.io (60 calls/min no free)
FINNHUB_KEY=

# ---- IA (Prompt 2 — consenso) ----
# OpenRouter: https://openrouter.ai (modelos :free — ver lista em lib/services/openrouter.ts)
OPENROUTER_KEY=
# NVIDIA NIM (opcional): https://build.nvidia.com
NVIDIA_KEY=
# Modelo NVIDIA opcional (ex.: meta/llama-3.1-405b-instruct)
NVIDIA_MODEL=
# Lista custom de modelos gratuitos OpenRouter (vírgula) — opcional
OPROUTER_FREE_MODELS=
# Consenso: quantos modelos, acordo mínimo, confiança mínima
AI_MAX_MODELS=3
AI_MIN_AGREE=2
AI_MIN_CONFIDENCE=60
AI_TIMEOUT_MS=20000
AI_ATTEMPT_CAP=8

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Segurança Cron ----
# Header x-cron-secret (ou ?secret=). Chamar via cron-job.org a cada 2 min:
#   POST https://SEU-DOMINIO/api/cron
#   Header: x-cron-secret: SEU_SECRET
CRON_SECRET=

# ---- Config ----
# Intervalo em segundos (documentação — o agendamento é feito no cron-job.org)
CRON_INTERVAL=120
DEFAULT_SCORE_MIN=75
# Horários de mercado fixos no código (src/lib/schedule.ts):
# janela da IQ Option (UTC) p/ forex + pregão NYSE p/ ações. Não precisa de env.
# Payout % do Paper Trading (win)
PAPER_PAYOUT_PCT=80